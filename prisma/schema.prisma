
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  USER
  ADMIN
}

model User {
  id String @id @default(cuid())
  clerkId String @unique
  username String @unique
  email String @unique

  role UserRole @default(USER)

  firstName String?
  lastName String?
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}